########################################################################
# OBCS-Nifty — environment template.
#
#   cp .env.example .env   and then EDIT every value marked CHANGE-ME.
#
# NEVER commit the real .env. The demo JWT secret/keys below are the
# publicly-documented Supabase self-hosting defaults and MUST be replaced
# for any non-local deployment (regenerate keys with the Supabase key tool
# so they are signed with your own JWT secret).
########################################################################

# ── Postgres ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE-ME-super-secret-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── Supabase JWT / API keys (CHANGE for production) ──────────────────────
# JWT secret must be >= 32 chars. ANON_KEY and SERVICE_ROLE_KEY must be JWTs
# signed with this exact secret.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzgzNTI5NTE0LCJleHAiOjIwOTg4ODk1MTR9.OaG11_iPeNncJQOuHzEqdctyqJP67tzrxLii4CRsDXE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3ODM1Mjk1MTQsImV4cCI6MjA5ODg4OTUxNH0.U_7kWyksmSdkfMFHK-Nspao9ZOuF3Lt1eUNiiCfPUkg

# ── Supabase service endpoints (internal docker network) ─────────────────
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=true                 # single seeded user; block public signup
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true

# ── Backend (Go) ─────────────────────────────────────────────────────────
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
# Backend connects as the postgres superuser (owns tables, bypasses RLS).
DATABASE_URL=postgres://postgres:CHANGE-ME-super-secret-postgres-password@db:5432/postgres?sslmode=disable
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
SUPABASE_JWT_SECRET=${JWT_SECRET}

# ── Trading mode ───────────────────────────────────────────────────────────
# paper (default, safe) or live. live REQUIRES the AngelOne credentials below.
TRADING_MODE=paper

# ── AngelOne SmartAPI (only needed for live mode, or real paper-mode data) ──
AO_API_KEY=
AO_CLIENT_CODE=
AO_MPIN=
AO_TOTP_SECRET=
AO_BASE_URL=https://apiconnect.angelbroking.com
AO_LOCAL_IP=127.0.0.1
AO_PUBLIC_IP=
AO_MAC_ADDR=

# ── Strategy tunables (defaults match Backtest/simulator.py) ────────────────
STRAT_UNDERLYING=NIFTY
STRAT_LOT_SIZE=65
STRAT_LOTS=2
STRAT_STRIKE_STEP=50
STRAT_STRIKE_DIST_PCT=1.0
STRAT_DTE_TARGET=14
STRAT_RISK_FREE_RATE=0.06
STRAT_DIV_YIELD=0.0125
STRAT_HV_WINDOW=20
STRAT_USE_DYNAMIC_HV=true
STRAT_FIXED_IV=0.155
STRAT_IV_MULT=1.10
STRAT_IV_ADD=0.0
STRAT_SKEW_PTS=-0.25
STRAT_USE_EMA=false
STRAT_EMA_PERIOD=55
STRAT_USE_EXPIRY_CAL=true
STRAT_EXPIRY_WEEKDAY=Auto (NSE)
STRAT_INITIAL_CAPITAL=200000
STRAT_USE_AGC=false
STRAT_KELLY_MULT=0.5
STRAT_AGC_WINDOW=30
STRAT_MAX_LOTS=10
STRAT_ENABLE_COSTS=true
STRAT_SLIPPAGE_PTS=0.10
STRAT_BROKERAGE_PER_ORDER=20.0
STRAT_STT_PCT=0.10
STRAT_EXCH_PCT=0.035
STRAT_GST_PCT=18.0
STRAT_STAMP_PCT=0.003
STRAT_ENTRY_TIME=15:20
STRAT_EXIT_TIME=09:20

# ── Frontend (Nuxt) — public runtime config ────────────────────────────────
NUXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NUXT_PUBLIC_SUPABASE_KEY=${ANON_KEY}
NUXT_PUBLIC_API_BASE=http://localhost:8080

# Session-cookie Secure flag baked into the SPA (see OBCS-frontend/README.md →
# "Secure cookies in production"). Leave unset/true for HTTPS. Set to false ONLY
# for a plain-HTTP deployment on a trusted network (localhost is exempt either
# way). The prod compose forces this to true.
# NUXT_SUPABASE_COOKIE_SECURE=true

# ── Production (docker-compose.prod.yml — Caddy + Cloudflare DNS ACME) ───────
# Caddy is the only public service; all public URLs are derived from DOMAIN, so
# in prod you do NOT set SUPABASE_PUBLIC_URL / SITE_URL / NUXT_PUBLIC_* by hand.
DOMAIN=2gn0rdfjsbad6.cougarbytes.net
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone:DNS:Edit on the zone (used for the DNS-01 ACME
# challenge). Create at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=CHANGE-ME
# Rotate this for prod (Realtime signing key base).
REALTIME_SECRET_KEY_BASE=CHANGE-ME-random-64-chars
